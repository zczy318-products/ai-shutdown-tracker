# dependencies
/node_modules

# next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# local embedded postgres (PGlite) data directories, including the throwaway
# ones the verification scripts create (.pglite-public-check, …)
/.pglite*/

# scratch directories the verification scripts build and tear down: the project
# copy `npm run verify:subscribe` uses (it has to live inside the repo so
# Turbopack can resolve node_modules by walking up), and the throwaway database
# `npm run verify:roles` migrates, seeds and serves.
/.verify-*/

# secrets — only .env.example is tracked
.env
.env.local
.env.*.local

# agent harness settings — machine-local absolute paths, not project config
/.claude/settings.local.json

# misc
.DS_Store
*.pem
npm-debug.log*
