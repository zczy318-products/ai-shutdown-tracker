# dependencies
/node_modules

# next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# local embedded postgres (PGlite) data directories, including the throwaway
# ones the verification scripts create (.pglite-public-check, …)
/.pglite*/

# scratch project copy used by `npm run verify:subscribe` — it needs to live
# inside the repo so Turbopack can resolve node_modules by walking up
/.verify-subscribe/

# secrets — only .env.example is tracked
.env
.env.*
!.env.example

# agent harness settings — machine-local absolute paths, not project config
/.claude/settings.local.json

# misc
.DS_Store
*.pem
npm-debug.log*

# Local deployment metadata, credentials, and generated security reports
.vercel/
*.key
*.p12
*.pfx
*.log
security-reports/

# Generated authenticated acceptance captures stay local.
/docs/acceptance/local/
