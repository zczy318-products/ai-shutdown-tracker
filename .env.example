# ─────────────────────────────────────────────────────────────────────────────
# AI Shutdown Tracker — environment variables
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Database driver selection.
#
#   DATABASE_URL set    -> node-postgres against a hosted/managed Postgres
#   DATABASE_URL unset  -> PGlite, an embedded Postgres persisted to ./.pglite
#
# Leave this commented out for local development: the app boots with zero
# external services. REQUIRED in production — PGlite writes to disk, so a
# serverless deployment without DATABASE_URL fails fast on first DB access.
#
# On Vercel, use Neon's *pooled* connection string (hostname contains
# `-pooler`). Use the direct one only for `npm run db:migrate`.
# DATABASE_URL=postgres://user:password@host:5432/ai_shutdown_tracker

# Where PGlite persists its data when DATABASE_URL is unset.
# Relative paths resolve from the repo root. Optional.
# PGLITE_DATA_DIR=./.pglite

# TLS for the node-postgres driver. Defaults to on *with certificate
# verification*, which is what Neon / Supabase / RDS all support. Set to
# "false" only for a local, trusted Postgres reached over a private network.
# DATABASE_SSL=true

# Connection pool size per process. Defaults to 1, which is what a serverless
# deployment wants: every function instance has its own pool, so anything
# larger multiplies against the instance count and exhausts Neon's free-tier
# connection limit. Raise it only for a long-lived server.
# DATABASE_POOL_MAX=1

# How long an idle pooled connection is kept before being released.
# Defaults to 10000 ms. Short on purpose, for the same reason as above.
# DATABASE_IDLE_TIMEOUT_MS=10000

# Escape hatch: allow PGlite while NODE_ENV=production. Only for smoke-testing
# a local `npm run build && npm start`. Never set this on a deployment.
# PGLITE_ALLOW_PRODUCTION=true

# ── T6 (Stripe, test mode only) ──────────────────────────────────────────────
# Not read by the code yet; listed so the Vercel project can be configured in
# one pass. Stripe stays in test mode — no real payment capture.
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRICE_ID_PRO=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_APP_URL=https://<project>.vercel.app
